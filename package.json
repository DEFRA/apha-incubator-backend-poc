{
  "name": "apha-incubator-backend-poc",
  "version": "0.0.0",
  "description": "apha-incubator-backend-poc",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "dev": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "dev:up": "docker compose up --build --attach apha-incubator-backend-poc",
    "docker:test": "npm run lint && (mkdir -p coverage/.tmp 2>/dev/null || true) && docker compose -p apha-incubator-backend-poc-test down -v && docker compose -f compose.yml -f compose.test.yml -p apha-incubator-backend-poc-test run --build --rm apha-incubator-backend-poc",
    "docker:test:watch": "docker compose -p apha-incubator-backend-poc-test down -v && docker compose -f compose.yml -f compose.test.yml -f compose.test.watch.yml -p apha-incubator-backend-poc-test run --build --rm apha-incubator-backend-poc",
    "format": "prettier --write \"**/*.{cjs,js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,ts,json,md}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run typecheck && npm run format:check && npm run lint && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js,ts}\"",
    "lint:fix": "npm run lint -- --fix",
    "security-audit": "npm audit --audit-level=critical",
    "server:debug": "tsx watch --conditions=development --inspect-brk=0.0.0.0 ./src/index.ts",
    "server:watch": "tsx watch --conditions=development --inspect=0.0.0.0 ./src/index.ts",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node ./dist/index.js",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1050.0",
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.5.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.0",
    "hapi-swagger": "17.3.2",
    "joi": "18.2.1",
    "mongo-locks": "3.1.2",
    "mongodb": "7.1.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.6",
    "@types/hapi__boom": "7.4.1",
    "@types/hapi__hapi": "20.0.13",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "hapi-swagger": {
      "joi": "$joi"
    }
  }
}
